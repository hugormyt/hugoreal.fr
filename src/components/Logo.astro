---
// Monogramme HR : le H et le R partagent la même barre verticale.
// La jambe du R (en accent) sort du cadre, comme un chemin qui part.
interface Props { size?: number; class?: string }
const { size = 32, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  stroke-width="6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  role="img"
  aria-label="HR"
>
  <path d="M10 10V54M10 32H30M30 10V54M30 10H41a11 11 0 0 1 0 22H30" stroke="currentColor" />
  <path d="M39 32L54 55" stroke="var(--accent, #ff4a1c)" stroke-linecap="butt" />
</svg>
