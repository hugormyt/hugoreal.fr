---
import { site } from '../data/site';
const built = new Date().toISOString().slice(0, 10);
---

<footer class="footer">
  <div class="wrap inner mono">
    <span>© {new Date().getFullYear()} {site.name}</span>
    <span>Static site · built {built}</span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); padding-block: 28px; color: var(--ink-soft); }
  .inner { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; }
</style>
