---
import { site } from '../data/site';
---

<section class="hero" data-tour-zone>
  <canvas data-tour aria-hidden="true"></canvas>

  <div class="wrap content">
    <p class="mono kicker">Entrepreneur · Operational research · Data</p>
    <h1 class="serif">
      Hugo Real<br />
      <em>finds the shortest path</em><br />
      between an idea and a company.
    </h1>
    <div class="cta">
      <a class="btn" href="#about">Who is this <span aria-hidden="true">↓</span></a>
      <a class="link mono" href={site.links.mytracks} target="_blank" rel="noopener">MyTracks ↗</a>
    </div>
  </div>

  <p class="wrap readout mono">
    <span class="dot" aria-hidden="true"></span>
    <span data-tour-readout>travelling salesman · live</span>
    <span class="hint">— click anywhere to add a city</span>
  </p>
</section>

<script>
  import '../scripts/tour.ts';
</script>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 56px);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    cursor: crosshair;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .content {
    position: relative;
    align-self: center;
    padding-block: 64px;
    pointer-events: none;
  }
  .content a { pointer-events: auto; }
  .kicker { color: var(--ink-soft); margin: 0 0 24px; }
  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 8.4vw, 7rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    max-width: 14ch;
    text-wrap: balance;
  }
  h1 em { color: var(--accent); }
  /* léger halo papier derrière le texte pour rester lisible sur les tracés */
  h1, .kicker { text-shadow: 0 0 18px var(--paper), 0 0 6px var(--paper); }
  .cta { display: flex; align-items: center; gap: 24px; margin-top: 40px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; gap: 10px; align-items: center;
    background: var(--ink); color: var(--paper);
    padding: 14px 22px; border-radius: 999px;
    text-decoration: none; font-weight: 500;
    transition: background .2s, color .2s;
  }
  .btn:hover { background: var(--accent); color: var(--accent-ink); }
  .link { text-decoration: none; }
  .readout {
    position: relative;
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    margin: 0; padding-bottom: 20px;
    color: var(--ink-soft);
    font-size: 0.7rem;
    pointer-events: none;
  }
  .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: pulse 1.6s infinite; }
  .hint { opacity: .7; }
  @keyframes pulse { 50% { opacity: .2; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  @media (max-width: 600px) { .hint { display: none; } }
</style>
