---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, formatDate } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---

<Base title={note.data.title} description={note.data.description}>
  <article class="wrap page">
    <a class="mono back" href="/notes/">← All notes</a>
    <header>
      <p class="mono meta">
        <time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
        {note.data.tags.map((t) => <span>· {t}</span>)}
        {note.data.draft && <span class="draft">· draft</span>}
      </p>
      <h1 class="serif">{note.data.title}</h1>
      <p class="lede">{note.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .page { padding-block: clamp(40px, 7vw, 88px); }
  .back { color: var(--ink-soft); text-decoration: none; }
  header { margin: 40px 0 48px; max-width: 800px; }
  .meta { color: var(--ink-soft); display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 16px; }
  .draft { color: var(--accent); }
  h1 { font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1.02; margin: 0 0 20px; }
  .lede { font-size: 1.2rem; color: var(--ink-soft); margin: 0; }
</style>
