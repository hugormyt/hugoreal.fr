---
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes } from '../../lib/notes';

const notes = await getNotes();
---

<Base title="Notes" description="Notes by Hugo Real on entrepreneurship, data and decision-making.">
  <section class="wrap page">
    <p class="mono kicker">Notes</p>
    <h1 class="serif">Things I learned the hard way, written down.</h1>
    <NoteList notes={notes} />
  </section>
</Base>

<style>
  .page { padding-block: clamp(48px, 8vw, 96px); }
  .kicker { color: var(--ink-soft); margin: 0 0 16px; }
  h1 { font-size: clamp(2.4rem, 6vw, 4.5rem); line-height: 1; margin: 0 0 clamp(40px, 6vw, 64px); max-width: 16ch; }
</style>
