---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="wrap page">
    <p class="mono kicker">Error 404</p>
    <h1 class="serif">No path leads here.<br /><em>Even the optimal one.</em></h1>
    <a class="mono" href="/">← Back home</a>
  </section>
</Base>

<style>
  .page { min-height: 70svh; display: grid; align-content: center; padding-block: 80px; }
  .kicker { color: var(--ink-soft); margin: 0 0 16px; }
  h1 { font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: 1; margin: 0 0 32px; }
  em { color: var(--accent); }
</style>
